# Copia este archivo como .env para cambiar la configuración local.
# Las variables de entorno reales tienen prioridad sobre este archivo.

# Dirección del servidor HTTP. La API no tiene autenticación: no la expongas fuera de loopback.
APP_HTTP_ADDR=127.0.0.1:8080

# Directorio de datos y ruta de la base SQLite (por defecto, dentro de APP_DATA_DIR).
APP_DATA_DIR=data
# APP_DATABASE_PATH=data/adaptive-scraper.db

# Navegadores simultáneos como máximo.
APP_MAX_CONCURRENT_JOBS=2

# Duración máxima de un trabajo (0 = sin límite).
APP_JOB_TIMEOUT=10m

# Navegador sin ventana.
PLAYWRIGHT_HEADLESS=true

# Directorio con la interfaz web compilada (`make web-build`).
APP_WEB_DIR=web/dist

# --- Seguridad ---
# Por defecto el navegador no puede llegar a este equipo ni a la red local
# (localhost, 10.x, 192.168.x, 169.254.x...). Ponlo en true solo para usar el
# sitio de demostración o extraer de un servidor de tu propia red.
APP_ALLOW_PRIVATE_NETWORKS=false

# Megabytes que el navegador puede recibir por conexión (0 = sin límite).
APP_MAX_RESPONSE_MB=256

# Nombres con los que se puede acceder al servidor además de localhost y
# 127.0.0.1, separados por comas. Solo hace falta si lo publicas con otro nombre.
# APP_ALLOWED_HOSTS=scraper.midominio.lan

# Guardar una captura y una traza de Playwright cuando un trabajo falla o
# queda bloqueado, en <APP_DATA_DIR>/diagnostics, y durante cuánto tiempo.
APP_DIAGNOSTICS=false
APP_DIAGNOSTICS_RETENTION=168h

# --- IA (opcional) ---
# Con IA se puede pedir una extracción describiendo los datos, y las recetas
# que dejan de funcionar se reparan solas. Requiere Ollama en marcha
# (`ollama serve`) y el modelo descargado (`make ollama-pull`).
AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Modelo de Ollama. Cualquiera que admita salida estructurada sirve; uno
# mayor acierta más y tarda más. Compruébalo con `make test-ai`.
OLLAMA_MODEL=llama3.2:3b

# Intentos de reparación por trabajo (0 a 5) y tiempo máximo por consulta al modelo.
AI_MAX_REPAIRS=2
AI_TIMEOUT=5m
