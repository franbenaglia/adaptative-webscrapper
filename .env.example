# Copia este archivo como .env para cambiar la configuración local.
# Las variables de entorno reales tienen prioridad sobre este archivo.

# Dirección del servidor HTTP. La API no tiene autenticación: no la expongas fuera de loopback.
APP_HTTP_ADDR=127.0.0.1:8080

# Directorio de datos y ruta de la base SQLite (por defecto, dentro de APP_DATA_DIR).
APP_DATA_DIR=data
# APP_DATABASE_PATH=data/adaptive-scraper.db

# Navegadores simultáneos como máximo.
APP_MAX_CONCURRENT_JOBS=2

# Duración máxima de un trabajo (0 = sin límite).
APP_JOB_TIMEOUT=10m

# Navegador sin ventana.
PLAYWRIGHT_HEADLESS=true
